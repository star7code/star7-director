{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://star7.local/director-project.schema.json",
  "title": "Star7 Director Project",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "assets",
    "shots"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "title": {
      "type": "string"
    },
    "settings": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 32,
          "maximum": 8192,
          "multipleOf": 32
        },
        "height": {
          "type": "integer",
          "minimum": 32,
          "maximum": 8192,
          "multipleOf": 32
        },
        "fps": {
          "const": 24
        }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "character",
              "scene",
              "prop",
              "effect",
              "voice",
              "video"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "voice_id": {
            "type": "string"
          },
          "media": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "source"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "image",
                    "audio",
                    "video"
                  ]
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "prompt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 60
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "post": {
            "type": "object",
            "properties": {
              "hd": {
                "type": "boolean"
              },
              "face": {
                "type": "boolean"
              }
            }
          },
          "continuity": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "const": "independent"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "mode",
                  "source_shot"
                ],
                "properties": {
                  "mode": {
                    "enum": [
                      "previous_latent",
                      "motion_guide",
                      "motion_redraw",
                      "tail_reference"
                    ]
                  },
                  "source_shot": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "mode",
                  "source_shot",
                  "frame"
                ],
                "properties": {
                  "mode": {
                    "const": "selected_frame"
                  },
                  "source_shot": {
                    "type": "string"
                  },
                  "frame": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
