{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Star7 Director AI Shot List",
  "type": "object",
  "required": [
    "schema_version",
    "shots"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "shots": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "prompt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 60
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "post": {
            "type": "object",
            "properties": {
              "hd": {
                "type": "boolean"
              },
              "face": {
                "type": "boolean"
              }
            }
          },
          "continuity": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "const": "independent"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "mode",
                  "source_shot"
                ],
                "properties": {
                  "mode": {
                    "enum": [
                      "previous_latent",
                      "motion_guide",
                      "motion_redraw",
                      "tail_reference"
                    ]
                  },
                  "source_shot": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "mode",
                  "source_shot",
                  "frame"
                ],
                "properties": {
                  "mode": {
                    "const": "selected_frame"
                  },
                  "source_shot": {
                    "type": "string"
                  },
                  "frame": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
